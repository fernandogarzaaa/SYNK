{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "SYNK Shell",
    "version": "0.1.0"
  },
  "build": {
    "distDir": "../dist",
    "devPath": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "identifier": "ai.synk.shell",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.png",
        "icons/icon.ico"
      ]
    },
    "allowlist": {
      "all": false,
      "shell": { "all": false, "open": true },
      "dialog": { "all": false, "message": true, "ask": true, "confirm": true }
    },
    "windows": [
      {
        "title": "SYNK Shell",
        "width": 480,
        "height": 800,
        "resizable": true
      }
    ]
  }
}
