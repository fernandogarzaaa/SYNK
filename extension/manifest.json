{
  "manifest_version": 3,
  "name": "AI Co-Work Browser (Prototype)",
  "version": "0.1.0",
  "description": "Human-AI co-browsing: sidebar assistant, semantic snapshots, guarded tool execution.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:18080/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AI Co-Work",
    "default_popup": "sidebar.html"
  },
  "side_panel": { "default_path": "sidebar.html" }
}
