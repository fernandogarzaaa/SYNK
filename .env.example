# Environment variables read by SYNK. Copy to .env and fill in as needed.
# No values are committed here on purpose.

# Cloud model routing (harness/orchestrator.py); without a key SYNK routes locally
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Local model selection (harness/local/model.py), e.g. mock | endpoint
SYNK_LOCAL_MODEL=
SYNK_LOCAL_MODEL_NAME=

# Model router overrides (harness/model_router.py): inline JSON or a file path
SYNK_MODELS=
SYNK_MODELS_FILE=

# harness/server.py WebMCP fallback toggle
SYNK_WEBMCP_FALLBACK=

# Opt-in live browser tests (tests/live)
SYNK_LIVE_BROWSER=
